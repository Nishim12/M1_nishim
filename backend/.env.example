# Server configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321

# Google Auth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT
JWT_SECRET=your_jwt_secret_key_here

# HTTPS (self-signed cert). Leave unset for local HTTP-only development.
SSL_CERT_PATH=
SSL_KEY_PATH=

# Overrides the server public IP returned by GET /api/server-ip. Required for
# local dev (no GCP metadata server); leave unset when deployed on GCP.
SERVER_PUBLIC_IP=

# Returned by GET /api/name
DEVELOPER_FIRST_NAME=
DEVELOPER_LAST_NAME=

# Other API keys, secrets, and configurations